<form asp-controller="Kitap" asp-action="Ekle" method="post">
    <div class="form-group">
        <label for="TurId">Tür Id</label>
        <input type="number" class="form-control" id="TurId" name="TurId">
    </div>
    <div class="form-group">
        <label for="KitapAdi">Kitap Adı</label>
        <input type="text" class="form-control" id="KitapAdi" name="KitapAdi">
    </div>
    <div class="form-group">
        <label for="Yazar">Yazar</label>
        <input type="text" class="form-control" id="Yazar" name="Yazar">
    </div>
    <div class="form-group">
        <label for="Yayinevi">Yayınevi</label>
        <input type="text" class="form-control" id="Yayinevi" name="Yayinevi">
    </div>
    <div class="form-group">
        <label for="SayfaSayisi">Sayfa Sayısı</label>
        <input type="number" class="form-control" id="SayfaSayisi" name="SayfaSayisi">
    </div>
    <button type="submit" class="btn btn-primary">Ekle</button>
</form>